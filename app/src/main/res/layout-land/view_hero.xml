<?xml version="1.0" encoding="utf-8"?>
<!-- The skin that is on now; in landscape the badge sits beside the text to save height. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hero"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/hero_badge"
        android:layout_width="@dimen/hero_icon"
        android:layout_height="@dimen/hero_icon">

        <com.neos.skinchange.ui.HeroBadgeView
            android:id="@+id/hero_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/hero_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_palette"
            app:tint="@color/on_skin" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hero_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hero_label"
            android:textAppearance="@style/TextAppearance.Skin.Label" />

        <TextView
            android:id="@+id/hero_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:maxLines="2"
            android:textColor="@color/on_skin"
            android:textSize="@dimen/hero_name"
            tools:text="Ночной" />

        <TextView
            android:id="@+id/hero_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/on_skin_muted"
            tools:text="Скин 2 из 4" />
    </LinearLayout>
</LinearLayout>
