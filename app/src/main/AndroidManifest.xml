<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ only lets us see (and launch) packages declared here: every app with a
         launcher icon, for the navigator picker, plus the known iGO builds. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="jp.pioneer.mbg.avicsync" />
        <package android:name="com.nng.igo.primong" />
        <package android:name="com.nng.igo.primogena" />
        <package android:name="com.nng.igo.avicsync" />
        <package android:name="com.basarsoft.igonextgen.javaclient" />
        <package android:name="com.nng.igoprimoisr.javaclient" />
        <package android:name="com.navngo.igo.javaclient" />
        <package android:name="com.nng.igo.pioneer" />
        <package android:name="com.nng.igoprimoisrael.javaclient" />
        <package android:name="com.nng.igo.navigation" />
        <package android:name="com.nng.igo.primong.hun10th" />
        <package android:name="com.nng.igo.primong.igoworld" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme.Main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:label="@string/action_help"
            android:theme="@style/AppTheme.Main" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/action_settings" />
    </application>
</manifest>
